# Copy this file to .env (same folder) and fill in your values. .env is git-ignored, never commit it.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# moomoo OpenD (the gateway app must be running and logged in on this PC)
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# 1 = also place each simulated trade in your moomoo PAPER account (never real money). 0 = off.
MOOMOO_PAPER_MIRROR=0
# Your moomoo broker entity: FUTUSG (Singapore), FUTUINC (US), FUTUAU, FUTUCA, FUTUMY, FUTUJP
MOOMOO_SECURITY_FIRM=FUTUSG

# 0 = keep desktop results only on this PC (don't push them to the data-moomoo branch)
PUBLISH_DESKTOP=1

# How the bot's window opens when the scheduled task starts it: Minimized (taskbar), Normal (pops up), Hidden
DESKTOP_WINDOW=Minimized
